# Allybot Fleet Robot API credentials
# Environment variables override missing YAML connector_config fields.
# Prefix: INORBIT_ALLYBOT_
INORBIT_ALLYBOT_BASE_URL=http://<ALLYBOT_SERVER_HOST>:28080
INORBIT_ALLYBOT_USERNAME=<ALLYBOT_USERNAME>
INORBIT_ALLYBOT_PASSWORD=your-password-here

# InOrbit
INORBIT_API_KEY=your-inorbit-api-key
