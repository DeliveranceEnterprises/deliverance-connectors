# Copy to config/.env and fill in values for a real InOrbit account.
# Do not commit config/.env.

# InOrbit credentials — required.
INORBIT_API_KEY=replace-with-your-inorbit-api-key

# Your InOrbit account ID — used when applying CAC files (cac/*.yaml).
# Replace <ACCOUNT_ID> placeholders in cac/actions.yaml and cac/robot_camera.yaml
# with this value before running: yes | inorbit apply -f cac/<file>.yaml
INORBIT_ACCOUNT_ID=replace-with-your-account-id

# Robot ID for the TurtleBot demo robot in your InOrbit account.
INORBIT_ROBOT_ID=turtlebot-demo-01

# Optional simulator overrides.
INORBIT_TURTLEBOT_PROVIDER_NAME=fake_turtlebot
INORBIT_TURTLEBOT_MOVEMENT_SPEED_MPS=0.35
