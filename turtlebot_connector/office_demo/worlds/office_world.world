<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="office_world">

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Suelo: 8.6444 m x 6.4203 m -->
    <model name="office_floor">
      <static>true</static>
      <pose>0 0 -0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>8.6444 6.4203 0.02</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>8.6444 6.4203 0.02</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Pared exterior superior (Acortada: hueco de 1.40m en el extremo izquierdo para la puerta) -->
    <!-- Hueco de puerta va de x = -4.2222 a x = -2.8222 (justo tras el canto interior de wall_left) -->
    <model name="wall_top">
      <static>true</static>
      <pose>0.75 3.1602 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>7.1444 0.10 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>7.1444 0.10 2.5</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- Pared exterior inferior -->
    <model name="wall_bottom">
      <static>true</static>
      <pose>0 -3.1602 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.6444 0.10 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.6444 0.10 2.5</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- Pared exterior izquierda (COMPLETA, sin huecos) -->
    <model name="wall_left">
      <static>true</static>
      <pose>-4.2722 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.10 6.4203 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.10 6.4203 2.5</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- Pared exterior derecha -->
    <model name="wall_right">
      <static>true</static>
      <pose>4.2722 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.10 6.4203 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.10 6.4203 2.5</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- Puerta doble en la PARED SUPERIOR, esquina izquierda (hueco de 1.40m) -->
    <!-- Centro del hueco: x = (-4.2222 + -2.8222) / 2 = -3.5222 -->
    <model name="door_double">
      <static>true</static>
      <pose>-3.5222 3.1602 1.00 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.40 0.05 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.40 0.05 2.0</size></box></geometry>
          <material>
            <ambient>0.6 0.3 0.1 1</ambient>
            <diffuse>0.6 0.3 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Estanterías contra la PARED IZQUIERDA (~4m de largo, corriendo en el eje Y) -->
    <!-- Cara trasera enrasada con el canto interior de wall_left (x = -4.2222) -->
    <!-- Profundidad 0.70m => centro en x = -4.2222 + 0.35 = -3.8722 -->
    <model name="shelves_left">
      <static>true</static>
      <pose>-3.8722 -0.5 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.70 4.00 1.50</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.70 4.00 1.50</size></box></geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Pared interior vertical aproximada (Original) -->
    <model name="wall_internal_vertical">
      <static>true</static>
      <pose>-0.1049 2.0982 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.10 2.2031 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.10 2.2031 2.5</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- Pared interior horizontal aproximada (Original) -->
    <model name="wall_internal_horizontal">
      <static>true</static>
      <pose>2.0982 0.9652 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.4062 0.10 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.4062 0.10 2.5</size></box></geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>
