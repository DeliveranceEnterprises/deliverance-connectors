# Ezviz Cloud account credentials
# Environment variables override missing YAML connector_config fields.
# Prefix: INORBIT_EZVIZ_

# Email used to log into the Ezviz mobile app.
INORBIT_EZVIZ_ACCOUNT=your-ezviz-email@example.com

# Ezviz account password.
INORBIT_EZVIZ_PASSWORD=your-ezviz-password

# Regional API host (no scheme, no trailing slash). Pick the one matching
# the region of your Ezviz account:
#   apiieu.ezvizlife.com   — EU (default)
#   apiius.ezvizlife.com   — US
#   apirus.ezvizru.com     — Russia
#   apisgp.ezvizlife.com   — Singapore / SEA
INORBIT_EZVIZ_REGION_URL=apiieu.ezvizlife.com

# Optional: target camera serial (9 chars, printed on the device label).
# The verification script uses this when capturing a snapshot.
# Leave blank to use the first device returned by the API.
INORBIT_EZVIZ_DEVICE_SERIAL=

# Optional: SMS 2FA code, only if your account has MFA enabled.
# INORBIT_EZVIZ_SMS_CODE=

# InOrbit
INORBIT_API_KEY=your-inorbit-api-key
